# Supabase — new API key system (the legacy anon / service_role JWTs are deprecated)
# Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Bypasses RLS — never expose to the browser, never commit.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Google AI Studio (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model overrides. Defaults are free-tier Flash models; Pro tiers are paid.
# GEMINI_GENERATOR_MODEL=gemini-3.5-flash
# GEMINI_CHECKER_MODEL=gemini-3.5-flash-lite
# GEMINI_CONCURRENCY=3

NEXT_PUBLIC_SITE_URL=http://localhost:3000
