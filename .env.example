# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Supabase — dashboard > Project Settings > API
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable key. This is the current key format; the legacy `anon` JWT is
# deprecated. Safe to expose — RLS applies as the signed-in user.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret key ("Secret keys" on the same page). SERVER ONLY — bypasses RLS
# entirely, so never import src/lib/supabase/service.ts from client code.
SUPABASE_SECRET_KEY=sb_secret_...

# ---------------------------------------------------------------------------
# Google Gemini — free key at https://aistudio.google.com/apikey (no card)
# ---------------------------------------------------------------------------

GEMINI_API_KEY=

# Preference-ordered model chains, comma-separated. Later entries are tried
# only when earlier ones are rate-limited or overloaded — free-tier Flash
# models return 503 in bursts. Only Flash / Flash-Lite tiers are free.
# Defaults shown; uncomment to override.
#GEMINI_GENERATOR_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-2.5-flash
#GEMINI_CHECKER_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash-lite,gemini-2.5-flash

# How many verification calls run at once. Free-tier limits are ~10 RPM, so
# keep this low. Default: 3
#GEMINI_CONCURRENCY=3

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Metadata base for canonical/OG URLs, and the host written into robots.txt
# and sitemap.xml. Set this in production. Auth does NOT use it — sign-in
# derives its redirect from window.location.origin. Default: https://lemma.app
#NEXT_PUBLIC_SITE_URL=http://localhost:3000
